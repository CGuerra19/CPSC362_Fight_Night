# Copy to .env and fill in. NEVER commit .env
# Provider options: groq | gemini | demo
LLM_PROVIDER=demo

GROQ_API_KEY=
GEMINI_API_KEY=

# Groq model for the pipeline (see console.groq.com/docs/models)
GROQ_MODEL=openai/gpt-oss-120b

# Pipeline version used by the web app (v1..v4)
PIPELINE_VERSION=v1

FLASK_DEBUG=1
